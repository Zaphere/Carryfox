# Copy to .env for local dev, or set these in the Vercel dashboard for deploys.
# Vercel does not load .env files — configure env vars under Project Settings.

# --- Database (required) ---
# On Vercel, use a hosted Postgres (Neon, Supabase, Vercel Postgres) and prefer
# its pooled connection string — each serverless instance opens its own pool.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Clerk auth (required) ---
CLERK_SECRET_KEY=sk_live_xxx
CLERK_PUBLISHABLE_KEY=pk_live_xxx
# Build-time key inlined into the frontend bundle. Must match CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxx
# Leave unset on Vercel (direct Clerk). Only set when proxying Clerk through
# the API (Replit-style custom-domain proxy).
# VITE_CLERK_PROXY_URL=

# --- App config ---
# Email allowed to access admin/dashboard routes (verified Clerk account).
ADMIN_OWNER_EMAIL=you@example.com

# --- Optional: WhatsApp Cloud API ---
# Without this, the API falls back to Replit Connectors (not available on Vercel).
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_GRAPH_API_VERSION=v23.0
# WHATSAPP_TEMPLATE_LANGUAGE=en_US

# --- Optional: local dev only ---
# PORT=25806
# API_PORT=8080
# BASE_PATH=/
# API_PROXY_TARGET=http://localhost:8080
# LOG_LEVEL=info
