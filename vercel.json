{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rootDirectory": ".",
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/api-server build && pnpm --filter @workspace/carryfox build",
  "outputDirectory": "artifacts/carryfox/dist/public",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[[...path]].ts": {
      "maxDuration": 30
    }
  }
}
